PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neocare
JWT_SECRET=replace_with_a_long_random_string

HIVEMQ_HOST=your-cluster-id.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=backend_user
HIVEMQ_PASSWORD=backend_password

FCM_SERVER_KEY=your_firebase_server_key

# =========================================================================
# STAGE 2: PRODUCTION OFFICIAL WHATSAPP BUSINESS GATEWAY (ZERO BAN RISK)
# =========================================================================
